# Project: Day 9 - Text Preprocessing for AI
# Concept: Lowercase, remove punctuation, tokenization

import string

def preprocess(user_data):
    txt = user_data.lower()  # Step 1: lowercase

    for p in string.punctuation:  # Step 2: remove punctuation
        txt = txt.replace(p, "")

    words = txt.split()  # Step 3: tokenization
    return words

sentence = "I am VERY happy!!!"
clean_words = preprocess(sentence)
print(clean_words)

