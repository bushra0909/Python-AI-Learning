# Project: Day 13 - Regular Expressions (re module)
# Concept: re.split() for sentence splitting

import re

user_tt = input("Enter text: ")
sentences = re.split(r"[.!]", user_tt)  # split by . or !
##Yes, in regex if we write r"\W+ in split function": here \W = non-word character (spaces, punctuation, symbols)
#in regex if we write r"\w+ in split function here \w = word character (letters, digits, underscore)
print(sentences)

emotion_words = {
    "happy": 2,
    "sad": -2,
    "very happy": 3,
    "very sad": -3
}

text = input("Enter how you are feeling: ").lower()
sntn = re.split(r"[.!]", text)
score = 0

for word in sntn:
    if word in emotion_words:
        score += emotion_words[word]

if score > 1:
    print("Mood is positive")
elif score < -1:
    print("Mood is negative")
else:
    print("Neutral mood")

print("Overall mood score:", score)

